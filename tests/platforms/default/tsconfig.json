{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vitest/globals"],
        "noEmit": true,
        "paths": {
            "@eventiva/core": ["../../packages/core/src/index.ts"],
            "@eventiva/core/*": ["../../packages/core/src/*"],
            "@eventiva/databases.pg": ["../../packages/databases/pg/src/index.ts"],
            "@eventiva/databases.pg/*": ["../../packages/databases/pg/src/*"],
            "@eventiva/extensions.hello-world": ["../../packages/extensions/hello-world/src/index.ts"],
            "@eventiva/extensions.hello-world/*": ["../../packages/extensions/hello-world/src/*"],
            "@eventiva/extensions.contact": ["../../packages/extensions/contact/src/index.ts"],
            "@eventiva/extensions.contact/*": ["../../packages/extensions/contact/src/*"],
            "@eventiva/platforms.default": ["../../packages/platforms/default/src/index.ts"],
            "@eventiva/platforms.default/*": ["../../packages/platforms/default/src/*"]
        }
    },
    "include": ["src/**/*.ts", "vitest.config.ts"]
}

{
    "name": "platforms-postgresql",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/platforms/postgresql/src",
    "projectType": "library",
    "tags": ["type:platform", "layer:backend"],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "dependsOn": ["lint", "^build"],
            "options": {
                "outputPath": "dist/platforms/postgresql",
                "main": "packages/platforms/postgresql/src/index.ts",
                "tsConfig": "packages/platforms/postgresql/tsconfig.lib.json",
                "assets": []
            }
        },
        "run": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:logs-cluster-all",
                "cwd": "{workspaceRoot}",
                "env": {
                    "EVENTIVA_CLUSTER_LOG_PROFILE": "postgresql"
                }
            },
            "dependsOn": ["cluster:wait"]
        },
        "run-local": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec tsx --tsconfig packages/platforms/postgresql/tsconfig.run.json packages/platforms/postgresql/src/platform.ts",
                "cwd": "{workspaceRoot}",
                "env": {
                    "NODE_ENV": "development",
                    "CLUSTER_APP_MODE": "primary",
                    "CLUSTER_HOOK_BUS": "off",
                    "DB_DATABASE": "effect_cluster",
                    "DB_USER": "cluster",
                    "DB_PASSWORD": "cluster",
                    "DB_HOST": "localhost",
                    "DB_PORT": "5432"
                }
            },
            "dependsOn": ["build"]
        },
        "run:local-fiber": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec tsx --tsconfig packages/platforms/postgresql/tsconfig.run.json packages/platforms/postgresql/src/platform.ts",
                "cwd": "{workspaceRoot}",
                "env": {
                    "NODE_ENV": "development",
                    "EVENTIVA_CLUSTER_INFRASTRUCTURE": "local",
                    "EVENTIVA_RUNTIME_TIER": "local",
                    "CLUSTER_HOOK_BUS": "off",
                    "DB_DATABASE": "effect_cluster",
                    "DB_USER": "cluster",
                    "DB_PASSWORD": "cluster",
                    "DB_HOST": "localhost",
                    "DB_PORT": "5432"
                }
            },
            "dependsOn": ["build"]
        },
        "cluster:render": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:render-fpk",
                "cwd": "{workspaceRoot}",
                "env": {
                    "EVENTIVA_RUNTIME_IMAGE": "docker.io/eventiva/runtime:local"
                }
            }
        },
        "cluster:apply": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:apply-fpk",
                "cwd": "{workspaceRoot}",
                "env": {
                    "EVENTIVA_CLUSTER_STACK": "postgresql"
                }
            },
            "dependsOn": ["cluster:render", "cluster:images:build"]
        },
        "cluster:images:build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:build-local-images",
                "cwd": "{workspaceRoot}",
                "env": {
                    "EVENTIVA_RUNTIME_IMAGE": "docker.io/eventiva/runtime:local",
                    "EVENTIVA_CLUSTER_STACK": "postgresql"
                }
            },
            "dependsOn": ["build"]
        },
        "cluster:wait": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:wait-rollout",
                "cwd": "{workspaceRoot}",
                "env": {
                    "EVENTIVA_CLUSTER_STACK": "postgresql"
                }
            },
            "dependsOn": ["cluster:apply"]
        },
        "cluster:delete": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:delete-fpk",
                "cwd": "{workspaceRoot}"
            }
        },
        "cluster:scale-down": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:scale-down-fpk",
                "cwd": "{workspaceRoot}"
            }
        },
        "cluster:status": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:status-fpk",
                "cwd": "{workspaceRoot}"
            }
        },
        "cluster:logs": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:logs-fpk",
                "cwd": "{workspaceRoot}"
            }
        },
        "cluster:logs:all": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:logs-cluster-all",
                "cwd": "{workspaceRoot}",
                "env": {
                    "EVENTIVA_CLUSTER_LOG_PROFILE": "postgresql"
                }
            }
        },
        "cluster:port-forward": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:port-forward-fpk",
                "cwd": "{workspaceRoot}"
            }
        },
        "verify-pg-e2e": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec nx run cluster-tooling:pg-e2e",
                "cwd": "{workspaceRoot}",
                "env": {
                    "NODE_ENV": "development",
                    "EVENTIVA_DATABASE": "postgres",
                    "EVENTIVA_HTTP_PORT": "3000",
                    "CONTACT_SEED_ENABLED": "false",
                    "PGPORT": "5432",
                    "PGUSER": "postgres",
                    "PGPASSWORD": "postgres",
                    "HOST": "localhost",
                    "DATABASE": "postgres",
                    "SSL": "false",
                    "EVENTIVA_FEATURE_DEVTOOLS": "true"
                }
            },
            "dependsOn": ["build"]
        }
    }
}

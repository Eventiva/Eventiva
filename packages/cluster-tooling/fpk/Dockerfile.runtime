FROM node:22-alpine
WORKDIR /app

RUN corepack enable
ENV CYPRESS_INSTALL_BINARY=0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json eslint.config.mjs ./
COPY patches ./patches
COPY packages ./packages

RUN pnpm install --frozen-lockfile
RUN pnpm nx run-many -t build -p core,platforms-postgresql --skip-nx-cache --excludeTaskDependencies

ENV NODE_ENV=production
CMD ["pnpm","exec","tsx","--tsconfig","packages/platforms/postgresql/tsconfig.run.json","packages/platforms/postgresql/src/platform.ts"]

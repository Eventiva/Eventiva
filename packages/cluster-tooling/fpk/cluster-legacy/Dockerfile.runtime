FROM node:22-alpine
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json eslint.config.mjs ./
COPY patches ./patches
COPY packages ./packages
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile
RUN pnpm nx run platforms-postgresql:build

ENV NODE_ENV=production
CMD ["pnpm","exec","tsx","--tsconfig","packages/platforms/postgresql/tsconfig.run.json","packages/platforms/postgresql/src/index.ts"]

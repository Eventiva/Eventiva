{
    "name": "@eventiva/databases.sqlite",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/databases/sqlite/src",
    "projectType": "library",
    "tags": ["type:database", "layer:backend"],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/databases/sqlite",
                "main": "packages/databases/sqlite/src/index.ts",
                "tsConfig": "packages/databases/sqlite/tsconfig.lib.json",
                "assets": []
            }
        },
        "run": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec tsx --tsconfig packages/platforms/sqlite-demo/tsconfig.run.json packages/platforms/sqlite-demo/src/index.ts",
                "cwd": "{workspaceRoot}",
                "env": {
                    "NODE_ENV": "development",
                    "EVENTIVA_DATABASE": "sqlite",
                    "EVENTIVA_SQLITE_PATH": "./.data/eventiva.sqlite",
                    "EVENTIVA_HTTP_PORT": "3000",
                    "CONTACT_SEED_ENABLED": "true",
                    "HELLO_WORLD_GREETING": "Hello World",
                    "EVENTIVA_LOG_FILE": "/tmp/eventiva-effect.log",
                    "EVENTIVA_FEATURE_DEVTOOLS": "true",
                    "EVENTIVA_FEATURE_OBSERVABILITY": "true"
                }
            },
            "dependsOn": ["build"]
        }
    }
}

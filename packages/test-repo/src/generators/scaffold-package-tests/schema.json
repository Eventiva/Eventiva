{
    "$schema": "http://json-schema.org/schema",
    "cli": "nx",
    "id": "scaffold-package-tests",
    "title": "Scaffold mirrored test projects",
    "type": "object",
    "properties": {
        "directory": {
            "type": "string",
            "description": "tests/ root relative to workspace (usually tests)",
            "default": "tests",
            "$default": {
                "$source": "argv",
                "index": 0
            },
            "x-priority": "important"
        }
    },
    "additionalProperties": false
}

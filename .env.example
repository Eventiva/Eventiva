# OpenTelemetry / Firetiger OTLP export
# Copy to .env and fill in your values. Never commit .env.

# Base URL for OTLP ingest (e.g. Firetiger)
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.cloud.firetiger.com

# Basic Auth: set both to have Authorization header built automatically
FIRETIGER_USERNAME=
FIRETIGER_PASSWORD=

# Alternative: set custom headers directly (e.g. Authorization=Basic <base64>)
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-credentials>

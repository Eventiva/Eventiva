# =============================================================================
# Eventiva — settings reference (read this before changing anything)
# =============================================================================
#
# How to use:
#   1. Copy this file to `.env` in the same folder (the real `.env` is never committed).
#   2. Remove the `#` at the start of any line you want to turn on, and set the value after `=`.
#   3. Restart the server after saving so new values apply.
#
# Formats:
#   - `true` / `false` — turn a feature on or off (words in lowercase).
#   - Numbers — ports, timeouts in milliseconds, etc.
#   - Leave a value empty after `=` only when the notes say that is allowed.
#
# Technical note: the app reads these from the operating system “environment” at startup.
# =============================================================================

# -----------------------------------------------------------------------------
# Core — how the server identifies itself and listens for web traffic
# -----------------------------------------------------------------------------

# NODE_ENV
#   What: A short label for the kind of deployment (development machine vs live server vs automated tests).
#   Effect: Other parts of the system may treat “production” more strictly than “development”.
#   Typical values: development (your laptop), production (real users), test (CI).
# NODE_ENV=development

# EVENTIVA_HTTP_PORT
#   What: The TCP port number where the HTTP API listens (the number in http://localhost:3000).
#   Effect: If you change it, open the app in the browser using that port instead of 3000.
#   Typical values: 3000, 8080, or any free port your organisation allows.
# EVENTIVA_HTTP_PORT=3000

# EVENTIVA_INTEGRITY_NONCE
#   What: An optional secret string used together with integrity checks (if your deployment uses them).
#   Effect: When set, it can change how certain security checks behave; leave unset if you do not use that flow.
#   Typical: Leave blank unless your team gave you a specific value.
# EVENTIVA_INTEGRITY_NONCE=

# EVENTIVA_ENCRYPTION_KEY
#   What: An optional secret used to encrypt sensitive personal data at rest in the application layer.
#   Effect: If unset in development, a default may be used (not safe for real user data). For production, set a strong secret your team manages.
#   Typical: Leave blank only on local dev; use a proper secret in shared/staging/production.
# EVENTIVA_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Database — which database engine to use and how to connect
# -----------------------------------------------------------------------------

# EVENTIVA_DATABASE
#   What: Chooses whether the app uses PostgreSQL or SQLite.
#   Effect: postgres / postgresql / pg → PostgreSQL. sqlite → file-based SQLite. If unset, the app defaults to PostgreSQL-style behaviour.
#   Typical: postgres for shared or serious data; sqlite for a single file on one machine.
# EVENTIVA_DATABASE=postgres

# EVENTIVA_DATABASE_DIALECT
#   What: Older setting kept for compatibility; forces SQLite when set to sqlite.
#   Effect: Prefer EVENTIVA_DATABASE=sqlite instead; only use this if an old script still expects it.
# EVENTIVA_DATABASE_DIALECT=

# EVENTIVA_SQLITE_PATH
#   What: File path to the SQLite database file, or the special value :memory: (data only while the process runs).
#   Effect: Only matters when EVENTIVA_DATABASE is sqlite. Creates parent folders if needed for a file path.
#   Typical: ./.data/eventiva.sqlite for a file next to the project; :memory: for throwaway tests.
# EVENTIVA_SQLITE_PATH=./.data/eventiva.sqlite

# --- PostgreSQL connection (used when you run against PostgreSQL) ---
# The app reads these names from the environment. Use PGPORT (not PORT) if something else already uses PORT for HTTP.

# HOST
#   What: Network hostname or IP of the PostgreSQL server.
#   Effect: The app connects to this machine for the database.
#   Typical: localhost on your laptop; a hostname in Docker or cloud.
# HOST=localhost

# PGPORT
#   What: TCP port PostgreSQL listens on (often 5432).
#   Effect: Must match the port your Postgres server is actually using.
# PGPORT=5432

# PORT
#   What: Fallback if PGPORT is not set (same meaning as PGPORT).
#   Effect: Prefer PGPORT so PORT can stay free for other tools; only one of PGPORT vs PORT is needed.
# PORT=5432

# DATABASE
#   What: For PostgreSQL, the database name (catalog) to connect to. Also used as a legacy hint: if set to the word postgres, the app may select the PostgreSQL backend when EVENTIVA_DATABASE is unset.
#   Effect: All app data for that run goes to this named database on the server.
#   Typical: postgres (default on many installs) or a dedicated name your DBA created.
# DATABASE=postgres

# PGUSER
#   What: PostgreSQL login role (username) the app uses.
#   Effect: Must be a user that exists on the server and has permission to create/use tables.
# PGUSER=postgres

# USERNAME
#   What: Fallback if PGUSER is not set (some systems set USERNAME to your OS login).
#   Effect: Prefer PGUSER for Postgres; USERNAME is only a backup and may be wrong on Linux.
# USERNAME=postgres

# PGPASSWORD
#   What: Password for the PostgreSQL user.
#   Effect: Required unless the server uses trust/auth that does not need a password.
# PGPASSWORD=postgres

# PASSWORD
#   What: Fallback if PGPASSWORD is not set.
#   Effect: Same as PGPASSWORD; prefer PGPASSWORD for clarity.
# PASSWORD=postgres

# SSL
#   What: When true, the database connection uses TLS encryption to the server.
#   Effect: Use true when connecting to Postgres over the public internet or managed cloud; false is common on localhost.
# SSL=false

# PGHOST
#   What: Same idea as HOST, but the name many command-line tools (psql) expect.
#   Effect: The main app prefers HOST; use PGHOST for scripts and tools that read libpq-style variables.
# PGHOST=localhost

# PGDATABASE
#   What: Same idea as DATABASE for libpq-style tools.
#   Effect: Should match the database name you use for the app.
# PGDATABASE=postgres

# -----------------------------------------------------------------------------
# Logging and diagnostics — where messages go and how they look
# -----------------------------------------------------------------------------

# EVENTIVA_LOG_FILE
#   What: Full path to a log file where the application writes detailed log lines.
#   Effect: Creates or appends to that file; useful for auditing and troubleshooting.
#   Typical: A path under /tmp on Linux/Mac, or a folder your team uses for logs.
# EVENTIVA_LOG_FILE=/tmp/eventiva-effect.log

# EVENTIVA_LOG_FORMAT
#   What: Legacy single switch that sets the same format for both console and file output.
#   Effect: If you set this, it overrides the separate console/file format variables below for both.
#   Values: default, string, logfmt, pretty, json, structured (case-insensitive).
# EVENTIVA_LOG_FORMAT=

# EVENTIVA_LOG_FORMAT_CONSOLE
#   What: How log lines are formatted when printed to the terminal, if not overridden by EVENTIVA_LOG_FORMAT.
#   Effect: json and logfmt are machine-friendly; pretty is more human-readable in a terminal.
# EVENTIVA_LOG_FORMAT_CONSOLE=logfmt

# EVENTIVA_LOG_FORMAT_FILE
#   What: How log lines are written inside EVENTIVA_LOG_FILE, if not overridden by EVENTIVA_LOG_FORMAT.
#   Effect: json is common for log collectors; logfmt is compact text.
# EVENTIVA_LOG_FORMAT_FILE=json

# EVENTIVA_LOG_CONSOLE
#   What: When true, logs are also shown in the terminal; when false, file-only logging may dominate.
#   Effect: Turn false if you want less noise in the console but still keep files.
# EVENTIVA_LOG_CONSOLE=true

# EVENTIVA_LOG_FILE_MIN_LEVEL
#   What: Lowest severity of messages written to the log file (Trace, Debug, Info, Warning, Error, Fatal, None).
#   Effect: Trace/Debug are very chatty; Info is normal; higher levels reduce volume.
# EVENTIVA_LOG_FILE_MIN_LEVEL=Trace

# EVENTIVA_LOG_CONSOLE_MIN_LEVEL
#   What: Lowest severity printed to the terminal.
#   Effect: Often Info so the screen stays readable while files can still capture more detail.
# EVENTIVA_LOG_CONSOLE_MIN_LEVEL=Info

# EVENTIVA_OTEL_LOCAL_CONSOLE
#   What: When true, extra OpenTelemetry “mirror” lines (spans, metrics) are printed to the terminal.
#   Effect: Very verbose; useful for deep debugging, noisy for day-to-day work.
# EVENTIVA_OTEL_LOCAL_CONSOLE=false

# EVENTIVA_OTEL_MIRROR_EFFECT_LOG
#   What: When true, the same OpenTelemetry mirror data is also appended to EVENTIVA_LOG_FILE.
#   Effect: One combined audit file; set false if you only want OTEL data in the separate files below.
# EVENTIVA_OTEL_MIRROR_EFFECT_LOG=true

# EVENTIVA_OTEL_FILE_TRACES
#   What: Path to a JSON-lines file receiving trace/span snapshots (local export, not a replacement for full OTLP).
#   Effect: File grows over time; rotate or delete if disk space matters.
# EVENTIVA_OTEL_FILE_TRACES=/tmp/eventiva-otel-traces.jsonl

# EVENTIVA_OTEL_FILE_LOGS
#   What: Path to a JSON-lines file for mirrored OpenTelemetry log records.
# EVENTIVA_OTEL_FILE_LOGS=/tmp/eventiva-otel-logs.jsonl

# EVENTIVA_OTEL_FILE_METRICS
#   What: Path to a JSON-lines file for mirrored metric snapshots.
# EVENTIVA_OTEL_FILE_METRICS=/tmp/eventiva-otel-metrics.jsonl

# OTEL_EXPORTER_OTLP_ENDPOINT
#   What: URL of an OpenTelemetry collector (for example a hosted observability backend) that accepts OTLP over HTTP.
#   Effect: When set, telemetry can be sent off the machine; leave unset to disable that export.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# OTEL_EXPORTER_OTLP_HEADERS
#   What: Extra HTTP headers for OTLP requests, as comma-separated key=value pairs (for example API tokens).
#   Effect: Required by some vendors; leave empty if your endpoint does not need custom headers.
# OTEL_EXPORTER_OTLP_HEADERS=

# FIRETIGER_USERNAME
#   What: Username for HTTP Basic authentication to an OTLP endpoint (for example Firetiger).
#   Effect: If both this and FIRETIGER_PASSWORD are set, the app can build an Authorization header automatically instead of using OTEL_EXPORTER_OTLP_HEADERS.
# FIRETIGER_USERNAME=

# FIRETIGER_PASSWORD
#   What: Password paired with FIRETIGER_USERNAME for Basic auth to the OTLP endpoint.
#   Effect: Treat like any secret — do not commit real values; use your secret store or `.env` locally only.
# FIRETIGER_PASSWORD=

# -----------------------------------------------------------------------------
# Feature switches — turn whole subsystems on or off (true or false)
# -----------------------------------------------------------------------------
# Default for most is true (feature on). Set to false to disable that piece.

# EVENTIVA_FEATURE_OBSERVABILITY
#   What: Master switch for the observability stack (logging/metrics/tracing wiring).
#   Effect: false reduces instrumentation overhead; you lose visibility in dashboards and files.
# EVENTIVA_FEATURE_OBSERVABILITY=true

# EVENTIVA_FEATURE_DEVTOOLS
#   What: Enables Effect DevTools integration during startup (developer tooling around the Effect runtime).
#   Effect: false skips that layer; use false if you need a minimal run or hit tooling issues.
# EVENTIVA_FEATURE_DEVTOOLS=true

# EVENTIVA_FEATURE_CLUSTER
#   What: Enables the cluster/workflow runner integration used for distributed-style processing in-process.
#   Effect: false may break features that rely on that runner; only turn off for narrow debugging.
# EVENTIVA_FEATURE_CLUSTER=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS
#   What: Enables the HTTP/RPC layer that exposes entities over the API.
#   Effect: false means no entity HTTP server from this subsystem; most apps need this true.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_CLIENT_FETCH
#   What: When on, entity clients are wired for each registered entity (used with sharding-style setups).
#   Effect: false skips that wiring; only disable if a maintainer asks you to reproduce a specific issue.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_CLIENT_FETCH=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_SWAGGER
#   What: Serves API documentation (Swagger/OpenAPI) at the docs route when other flags allow it.
#   Effect: false hides generated API docs in the browser.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_SWAGGER=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_SERVE
#   What: Actually mounts the HTTP API routes on the server.
#   Effect: false means routes are not served; use only for specialised debugging.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_SERVE=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_FULL_LAYER_BUILD
#   What: When on, builds the full HTTP server layer graph; when off, a minimal path may be used.
#   Effect: false is for debugging startup; normal operation should keep this true.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_FULL_LAYER_BUILD=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_FULL_INIT
#   What: When on, runs the full entity-endpoint initialisation (sharding, entity setup, API layers).
#   Effect: false skips most of that (very limited server); for targeted debugging only.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_FULL_INIT=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_SHARDING
#   What: When on, the sharding service is initialised as part of entity endpoints.
#   Effect: false skips sharding; use if you isolate a bug to that layer.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_SHARDING=true

# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_TRACING
#   What: When on, wraps parts of entity endpoint setup with tracing helpers.
#   Effect: false reduces tracing noise or avoids a tracer issue during debugging.
# EVENTIVA_FEATURE_ENTITY_ENDPOINTS_TRACING=true

# EVENTIVA_FEATURE_SCHEMA_STACK
#   What: Enables the schema-registry / DDL stack used when extensions register tables.
#   Effect: false is almost never wanted in normal use; only for maintainer-led debugging.
# EVENTIVA_FEATURE_SCHEMA_STACK=true

# EVENTIVA_FEATURE_EXTENSIONS
#   What: When on, loads optional product extensions (contacts, hello-world, etc.).
#   Effect: false runs a slimmer server without those modules.
# EVENTIVA_FEATURE_EXTENSIONS=true

# -----------------------------------------------------------------------------
# PostHog — optional remote feature-flag service
# -----------------------------------------------------------------------------

# POSTHOG_API_KEY
#   What: Secret project API key from PostHog; when set, feature flags can be read from PostHog instead of only env vars.
#   Effect: If empty, the app uses the EVENTIVA_FEATURE_* values below only.
# POSTHOG_API_KEY=

# POSTHOG_PROJECT_API_KEY
#   What: Alternate name for the same PostHog key some teams use.
#   Effect: Same as POSTHOG_API_KEY; only one needs to be set.
# POSTHOG_PROJECT_API_KEY=

# POSTHOG_HOST
#   What: PostHog API host URL for your region or self-hosted instance.
#   Effect: Wrong host means flag requests fail; US cloud default is below if you use SaaS PostHog US.
# POSTHOG_HOST=https://us.i.posthog.com

# EVENTIVA_FEATURE_DISTINCT_ID
#   What: Stable identifier PostHog uses to decide which flag variants apply (often per server or per tenant).
#   Effect: Change it if you need different flag rollouts for different deployments.
# EVENTIVA_FEATURE_DISTINCT_ID=server

# -----------------------------------------------------------------------------
# Demo contact extension — sample data on first run
# -----------------------------------------------------------------------------

# CONTACT_SEED_ENABLED
#   What: When true, the app may create one demo contact row if the contacts table is empty.
#   Effect: false skips that automatic demo data (useful for clean automated tests).
# CONTACT_SEED_ENABLED=true

# CONTACT_SEED_FULLNAME
#   What: Full name used for the demo contact (split into first and last name).
#   Effect: Only used when seeding runs.
# CONTACT_SEED_FULLNAME=Jane Doe

# CONTACT_SEED_DATE_OF_BIRTH
#   What: Birth date for the demo contact (ISO-friendly date string).
# CONTACT_SEED_DATE_OF_BIRTH=1990-05-15

# CONTACT_SEED_EMAIL
#   What: Email address stored on the demo contact.
# CONTACT_SEED_EMAIL=jane@example.com

# CONTACT_SEED_PHONE
#   What: Phone number stored on the demo contact.
# CONTACT_SEED_PHONE=+1234567890

# -----------------------------------------------------------------------------
# Hello-world extension — sample greeting text
# -----------------------------------------------------------------------------

# HELLO_WORLD_GREETING
#   What: Text returned by the hello-world extension’s greeting.
#   Effect: Purely cosmetic/default content for demos.
# HELLO_WORLD_GREETING=Hello World

# -----------------------------------------------------------------------------
# Automated PostgreSQL E2E script only (not the main app)
# These affect `packages/cluster-tooling/cli/pg-e2e-via-nx.ts` when you run the verify command in CI or locally.
# -----------------------------------------------------------------------------

# PG_E2E_HTTP_TIMEOUT_MS
#   What: How long the script waits for HTTP responses when checking the running server (milliseconds).
#   Effect: Increase on slow machines; decrease to fail faster.
# PG_E2E_HTTP_TIMEOUT_MS=90000

# SKIP_PSQL
#   What: Set to 1 to skip steps that need the `psql` command-line tool.
#   Effect: Use when psql is not installed; some cleanup/reset steps will not run.
# SKIP_PSQL=0

# PG_E2E_SCHEMA_RESET
#   What: Set to 1 to run an optional schema reset path when `psql` is available (see script behaviour).
#   Effect: Can destroy/recreate schema data — only use when you intend to reset test databases.
# PG_E2E_SCHEMA_RESET=0

# PG_E2E_RESET
#   What: Set to 1 to run an optional database reset path when `psql` is available.
#   Effect: Destructive for test data — use only in disposable environments.
# PG_E2E_RESET=0

# -----------------------------------------------------------------------------
# Cluster platform demos (`@eventiva/platforms.postgresql` / `@eventiva/platforms.mysql`)
# -----------------------------------------------------------------------------

# CLUSTER_APP_MODE
#   What: Selects which cluster demo program runs (primary/runner entity host vs shooter modes).
#   Effect: primary and runner share the demo entity layer; shooter, speed-shooter, and slow-shooter run client-style programs. Invalid values fail at startup.
#   Typical: primary for the default demo; override when scripts or k8s set the mode.
# CLUSTER_APP_MODE=primary

# SHARDS_PER_GROUP
#   What: Effect `@effect/cluster` ShardingConfig — logical shards per shard group (default in library is 300).
#   Effect: FPK manifests default to `2` when unset at render time; must match on battleships, shard-manager, and every shooter. Changing an existing SQL-backed cluster may require a fresh DB.
#   Typical: `2` for local dev; `300` (or higher) for prod-like stress. Export before `apply-fpk-cluster` / render.
# SHARDS_PER_GROUP=2

# EVENTIVA_RUNTIME_TIER
#   What: Optional label for docs/tooling: `local` | `compose` | `kubernetes` (see docs/parts/local-dev/three-tier-platform-runtime.md).
#   Effect: Informational; set alongside the matching run command (e.g. `local` with `platforms-postgresql:run:local-fiber`).
# EVENTIVA_RUNTIME_TIER=local

# EVENTIVA_CLUSTER_INFRASTRUCTURE
#   What: PostgreSQL platform entry (`packages/platforms/postgresql/src/platform.ts`): `distributed` (default, SQL-backed cluster) or `local` (one process, in-memory cluster + colocated shooters).
#   Effect: `local` skips Postgres for cluster storage; use `CLUSTER_HOOK_BUS=off` and optional `EVENTIVA_LOCAL_CLUSTER_PORT` / `SHARDS_PER_GROUP`.
# EVENTIVA_CLUSTER_INFRASTRUCTURE=distributed

# EVENTIVA_LOCAL_CLUSTER_PORT
#   What: Runner RPC listen port when `EVENTIVA_CLUSTER_INFRASTRUCTURE=local` (`platforms-postgresql:run:local-fiber`).
#   Default: 34431
# EVENTIVA_LOCAL_CLUSTER_PORT=34431

# SHOOTER_MAX_SHOOTS
#   What: Caps `Shoot` RPCs from basic and speed shooter demo loops (unset in pod = unlimited).
#   Effect: FPK injects `5` by default for quieter logs; set `SHOOTER_MAX_SHOOTS=0` at render time to omit the var (unlimited). Runtime env for local `tsx` runs.
# SHOOTER_MAX_SHOOTS=5

# SPEED_SHOOTER_CONCURRENCY
#   What: Semaphore limit for concurrent in-flight `Shoot` calls in speed-shooter (default 30 in code).
# SPEED_SHOOTER_CONCURRENCY=30

# SPEED_SHOOTER_ENTITY_COUNT
#   What: Number of pre-built `DemoEntity` clients (`ship-0` …) in speed-shooter (default 500 in code).
# SPEED_SHOOTER_ENTITY_COUNT=500

# CLUSTER_HOOK_BUS
#   What: Cluster-wide hook fan-out transport. `kafka` subscribes runners to the hook dispatch topic; `off` keeps hooks local-only.
#   Effect: With `kafka`, local `runner` `onLoad` is skipped (avoid duplicate with bus); publish dispatches via Kafka instead.
#   Default in code and FPK manifests: kafka. Use off for unit tests or hosts without a broker.
# CLUSTER_HOOK_BUS=kafka

# KAFKA_BOOTSTRAP_SERVERS
#   What: Comma-separated broker list for effect-kafka (in-cluster DNS in k8s, e.g. redpanda.kafka.svc.cluster.local:9092).
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# KAFKA_TLS / KAFKA_SSL
#   What: Set to `true` to enable TLS to brokers. Optional `KAFKA_SSL_CA_PATH`, `KAFKA_SSL_CERT_PATH`, `KAFKA_SSL_KEY_PATH` for trust/client certs (Strimzi secrets).
# KAFKA_TLS=false

# EVENTIVA_HOOK_DISPATCH_TOPIC
#   What: Kafka topic for JSON hook dispatch envelopes from `@eventiva/core` (default `eventiva.hook.dispatch`).
# EVENTIVA_HOOK_DISPATCH_TOPIC=eventiva.hook.dispatch

# CLUSTER_EXTENSION_ID
#   What: Stable id for this extension deployment; Kafka consumer group becomes `eventiva-hooks-<id>`. Replicas of the same extension share the group.
# CLUSTER_EXTENSION_ID=

# EVENTIVA_CLUSTER_EXTENSIONS
#   What: `all` loads both demo extension layers; `copyright-notice` or `example-transform` loads one (use with separate pods / distinct consumer groups).
# EVENTIVA_CLUSTER_EXTENSIONS=all

# EVENTIVA_HOOK_DEDUPE_MAX
#   What: Max `eventId` entries kept per pod for at-least-once Kafka dedupe (LRU-style eviction).
# EVENTIVA_HOOK_DEDUPE_MAX=5000

# EVENTIVA_HOOK_TOPIC_RETENTION_MS
#   What: Kafka `retention.ms` for the hook dispatch topic when rendering the FPK topic-init Job (dev default 72h = 259200000).
# EVENTIVA_HOOK_TOPIC_RETENTION_MS=259200000

# EVENTIVA_KAFKA_WAIT_IMAGE
#   What: Init container image used when `CLUSTER_HOOK_BUS=kafka` at FPK render time to TCP-wait for the broker (default `bash:5.2` for /dev/tcp).
# EVENTIVA_KAFKA_WAIT_IMAGE=bash:5.2

# EVENTIVA_KAFKA_DEV_IMAGE / EVENTIVA_KAFKA_ADVERTISE_HOST
#   What: Override Redpanda image or advertised hostname when rendering FPK `packages/cluster-tooling/fpk/src/kafka` (local dev broker).

# EVENTIVA_SERVICE_NAME
#   What: OpenTelemetry `service.name` resource attribute for traces from `@eventiva/core` observability.
#   Effect: When unset, defaults to `eventiva-core` in tracing setup.
#   Typical: A short stable name per deployment or process role.
# EVENTIVA_SERVICE_NAME=eventiva-core

# EVENTIVA_EFFECT_DEVTOOLS
#   What: Enables `@effect/experimental` DevTools (WebSocket client for the Effect VS Code / Cursor extension tracer and metrics).
#   Effect: When unset or false, no DevTools layer is merged. When true, merges DevTools **before** OpenTelemetry tracing so the tracer patches correctly.
#   Typical: `true` during local debugging with the Effect extension; leave unset in production.
# EVENTIVA_EFFECT_DEVTOOLS=true

# EVENTIVA_EFFECT_DEVTOOLS_WS_URL
#   What: WebSocket URL of the DevTools server (default `ws://localhost:34437`). Use when the editor runs on another machine or you port-forward from a cluster pod.
#   Effect: Passed to `DevTools.layer(url)`; must match where the Effect extension backend listens.
#   Typical: `ws://127.0.0.1:34437` or a forwarded host/port.
# EVENTIVA_EFFECT_DEVTOOLS_WS_URL=ws://localhost:34437

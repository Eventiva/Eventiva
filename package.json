{
    "name": "@eventiva/eventiva",
    "version": "0.0.1",
    "private": true,
    "description": "Eventiva – event planning and production logistics platform (ERP from an events focus).",
    "repository": "https://github.com/eventiva/eventiva",
    "bugs": {
        "email": "support@eventiva.co.uk",
        "url": "https://github.com/Eventiva/Eventiva/issues/new/choose"
    },
    "type": "module",
    "packageManager": "pnpm@9.14.2",
    "scripts": {
        "lint": "nx run-many -t lint",
        "lint:fix": "nx run eventiva:lint-fix",
        "format": "nx run eventiva:format",
        "format:check": "nx run eventiva:format-check",
        "check": "nx run eventiva:check",
        "fix": "nx run eventiva:fix",
        "test": "nx run-many -t test",
        "cluster:render": "pnpm nx run platforms-postgresql:cluster:render",
        "cluster:apply": "pnpm nx run platforms-postgresql:cluster:apply",
        "cluster:images:build": "pnpm exec nx run cluster-tooling:build-local-images",
        "cluster:mysql:build": "pnpm nx run platforms-mysql:build",
        "cluster:wait": "pnpm nx run platforms-postgresql:cluster:wait",
        "cluster:delete": "pnpm nx run platforms-postgresql:cluster:delete",
        "cluster:scale-down": "pnpm nx run platforms-postgresql:cluster:scale-down",
        "cluster:status": "pnpm nx run platforms-postgresql:cluster:status",
        "cluster:logs": "pnpm nx run platforms-postgresql:cluster:logs",
        "cluster:logs:all": "pnpm nx run platforms-postgresql:cluster:logs:all",
        "cluster:port-forward": "pnpm nx run platforms-postgresql:cluster:port-forward",
        "cluster:compose:up": "pnpm exec nx run cluster-tooling:compose-up",
        "cluster:compose:down": "pnpm exec nx run cluster-tooling:compose-down",
        "cluster:compose:logs": "pnpm exec nx run cluster-tooling:compose-logs",
        "cluster:compose:verify-demo-logs": "pnpm exec nx run cluster-tooling:compose-verify-demo-logs",
        "platform:run:local-fiber": "pnpm exec nx run eventiva:platform:run:local-fiber",
        "platform:run:local": "pnpm exec nx run eventiva:platform:run:local",
        "platform:container:images-build": "pnpm exec nx run eventiva:platform:container:images-build",
        "platform:container:compose-up": "pnpm exec nx run eventiva:platform:container:compose-up",
        "platform:container:compose-down": "pnpm exec nx run eventiva:platform:container:compose-down",
        "platform:container:compose-logs": "pnpm exec nx run eventiva:platform:container:compose-logs",
        "platform:kubernetes:images-build": "pnpm exec nx run eventiva:platform:kubernetes:images-build",
        "platform:kubernetes:apply": "pnpm exec nx run eventiva:platform:kubernetes:apply",
        "platform:kubernetes:wait": "pnpm exec nx run eventiva:platform:kubernetes:wait",
        "cluster:run": "pnpm nx run platforms-postgresql:run",
        "cluster:run:mysql": "pnpm nx run platforms-mysql:run",
        "dev": "pnpm nx run platforms-postgresql:run",
        "dts:docs:enrich": "node packages/cluster-tooling/dts-docs/enrich-dts-docs.mjs dist",
        "dts:docs:check": "node packages/cluster-tooling/dts-docs/check-dts-docs.mjs dist",
        "tests:repo:bootstrap": "pnpm nx g @eventiva/test-repo-tooling:bootstrap-tests-repo --no-interactive",
        "local-ci:cluster": "pnpm exec nx run cluster-tooling:local-ci",
        "test:e2e": "nx run-many -t test:e2e --all --exclude=eventiva --output-style=stream",
        "test:coverage": "nx run-many -t test --projects=tag:scope:tests --output-style=stream -- --coverage",
        "test:coverage:strict": "COVERAGE_STRICT=1 pnpm test:coverage"
    },
    "pnpm": {
        "overrides": {
            "@effect/sql": "0.49.0",
            "effect": "3.19.19",
            "jsonpath-plus": "^10.3.0",
            "parse-duration": "^2.1.5"
        },
        "patchedDependencies": {
            "effect@3.19.19": "patches/effect@3.19.19.patch"
        }
    },
    "devDependencies": {
        "@effect/language-service": "^0.86.2",
        "@effect/vitest": "^0.29.0",
        "@eslint/js": "^9.8.0",
        "@eventiva/cluster-tooling": "workspace:*",
        "@eventiva/test-repo-tooling": "workspace:*",
        "@expo/cli": "~54.0.16",
        "@fpk/cli": "^0.1.58",
        "@fpk/k8s": "^0.7.0",
        "@module-federation/enhanced": "^0.21.2",
        "@nx/cypress": "22.7.3",
        "@nx/docker": "22.7.3",
        "@nx/eslint": "22.7.3",
        "@nx/eslint-plugin": "22.7.3",
        "@nx/expo": "22.7.3",
        "@nx/js": "22.7.3",
        "@nx/module-federation": "22.7.3",
        "@nx/plugin": "22.7.3",
        "@nx/react": "22.7.3",
        "@nx/rspack": "22.7.3",
        "@nx/vitest": "22.7.3",
        "@nx/web": "22.7.3",
        "@rspack/cli": "1.6.8",
        "@rspack/core": "1.6.8",
        "@rspack/dev-server": "^1.1.4",
        "@rspack/plugin-react-refresh": "^1.0.0",
        "@stepci/runner": "^2.0.7",
        "@swc-node/register": "~1.11.1",
        "@swc/cli": "~0.8.1",
        "@swc/core": "~1.15.40",
        "@swc/helpers": "~0.5.21",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "20.19.9",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.0.0",
        "@vitest/coverage-istanbul": "^2.1.9",
        "@vitest/coverage-v8": "^2.1.9",
        "autoprefixer": "10.5.0",
        "cypress": "^15.15.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.8.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-cypress": "^3.5.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsonc-eslint-parser": "^3.1.0",
        "metro-config": "~0.84.4",
        "metro-resolver": "~0.84.4",
        "nx": "22.7.3",
        "postcss": "8.5.15",
        "prettier": "~3.8.3",
        "react-refresh": "~0.18.0",
        "tailwindcss": "3.4.3",
        "ts-node": "10.9.2",
        "tslib": "^2.3.0",
        "tsx": "^4.22.3",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.59.4",
        "vite": "^7.0.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "@effect/cluster": "^0.58.2",
        "@effect/experimental": "^0.60.0",
        "@effect/opentelemetry": "^0.63.0",
        "@effect/rpc": "^0.75.1",
        "@opentelemetry/sdk-logs": "^0.218.0",
        "@opentelemetry/sdk-metrics": "^2.7.1",
        "effect": "^3.19.17",
        "expo": "~54.0.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-native": "0.85.3",
        "react-router-dom": "6.30.3"
    }
}
